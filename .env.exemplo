# INTRODUCAO
# Arquivo de exemplo de variaveis de ambiente do projeto Agente Analista de Dados.
# Copie para `.env` e preencha com os valores reais. O `.env` real NUNCA vai para o Git
# (esta no .gitignore). Aqui so existem valores de exemplo, sem nenhum segredo.
# RESUMO: modelo de `.env`; copiar, preencher e manter fora do versionamento.

# ---- Banco de dados (PostgreSQL 16) ----
POSTGRES_PASSWORD=troque-esta-senha-forte
SENHA_USUARIO_DASHBOARD=troque-senha-dashboard
SENHA_USUARIO_AGENTE=troque-senha-agente
SENHA_USUARIO_GERADOR=troque-senha-gerador

# ---- Agente de IA ----
# Chave da API DeepSeek (compativel com OpenAI). Obter em https://platform.deepseek.com
DEEPSEEK_API_KEY=sk-exemplo-troque-pela-chave-real
# Teto diario de custo em USD; ao atingir, o chat e desligado com mensagem amigavel.
TETO_CUSTO_DIARIO_USD=2.00
# Limite de perguntas por IP por hora (a aplicacao e publica, sem login).
LIMITE_PERGUNTAS_POR_HORA=20
# Maximo de passos de ferramenta por pergunta.
LIMITE_PASSOS_FERRAMENTA=8

# ---- Cloudflare Tunnel ----
# Token do tunel nomeado deste projeto. Fica apenas no .env da VM.
TUNNEL_TOKEN=exemplo-token-do-tunel-cloudflare

MODELO_AGENTE=deepseek-flash
# Estimativa conservadora: preço de pico sem cache, ver documentação DeepSeek.
PRECO_ENTRADA_USD_1M=0.30
PRECO_SAIDA_USD_1M=1.20
